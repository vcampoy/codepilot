# Local Compose configuration. Keep PostgreSQL and Redis internal to Compose.
POSTGRES_DB=codepilot
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=codepilot
API_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REPOSITORY_MAX_SIZE_BYTES=100000000
REPOSITORY_MAX_FILE_COUNT=50000
ANALYSIS_TIMEOUT_SECONDS=300
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
