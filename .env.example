# Local service ports
API_PORT=8000
FRONTEND_PORT=5173

# Local development database credentials only
POSTGRES_DB=codepilot
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=codepilot

# Browser-visible API origin, embedded during the frontend image build
VITE_API_BASE_URL=http://localhost:8000

# Worker transport
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
