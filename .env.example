# Local Compose configuration. Keep PostgreSQL and Redis internal to Compose.
POSTGRES_DB=codepilot
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=codepilot
API_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REPOSITORY_MAX_SIZE_BYTES=100000000
REPOSITORY_MAX_FILE_COUNT=50000
ANALYSIS_TIMEOUT_SECONDS=300
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_MODEL_FILE_RISK=
LLM_MODEL_REFACTORING_PLAN=
LLM_MODEL_DETERMINISTIC_SUMMARY=
LLM_API_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable and share the same value with the API and worker; never commit the secret.
LLM_CONFIG_ENCRYPTION_KEY=
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_RETRIES=3
FIX_EXECUTION_ENABLED=false
FIX_SANDBOX_URL=http://sandbox:8081
FIX_SANDBOX_TIMEOUT_SECONDS=300
OBSERVABILITY_ENABLED=false
OTEL_SERVICE_NAME=codepilot-api
ERROR_REPORTING_DSN=
AUTH_REQUIRED=false
AUTH_API_KEY=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WORKSPACE_ANALYSIS_QUOTA=100
QUALITY_GATE_MAX_NEW_CRITICAL_FINDINGS=
QUALITY_GATE_MAX_RISK_SCORE=
QUALITY_GATE_MAX_NEW_HOTSPOTS=
